        "issue.upsert": "#/$defs/IssueAction",
        "order.cancel": "#/$defs/CancelAction",
        "order.change_address": "#/$defs/AddressAction",
        "order.refund": "#/$defs/RefundAction",
        "reply.send": "#/$defs/ReplyAction"
